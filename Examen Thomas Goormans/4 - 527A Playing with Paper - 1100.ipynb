   "source": [
    "length, width = input().split(\" \")\n",
    "a = int(length)\n",
    "b = int(width)\n",
    "c = 0\n",
    "while (a > 0) and (b > 0):\n",
    "    if a > b:\n",
    "        c += a//b\n",
    "        a %= b\n",
    "    else:\n",
    "        c += b//a\n",
    "        b %= a\n",
    "print(c)"
   ]
