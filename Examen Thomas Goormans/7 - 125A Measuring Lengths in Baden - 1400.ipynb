    "n = int(input())\n",
    "if n % 3 == 1:\n",
    "    n += 1\n",
    "elif n % 3 == 2:\n",
    "    n += 1\n",
    "feet = n // 36\n",
    "inches = (n - feet*36) // 3\n",
    "print(f\"{feet} {inches}\")"
   ]
