   "source": [
    "w = int(input())\n",
    "\n",
    "deelbaar = \"NO\"\n",
    "for i in range (2, (w//2)+1):\n",
    "    if (i % 2 == 0) and ((w-i) % 2) == 0:\n",
    "        deelbaar = \"YES\"\n",
    "        break\n",
    "print(deelbaar)"
   ]
